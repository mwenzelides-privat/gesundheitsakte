{
  "name": "Gesundheitsakte",
  "short_name": "Gesundheit",
  "description": "Persönliche Gesundheitsakte mit Ablage in Google Drive",
  "lang": "de",
  "start_url": "./#start",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f5f5",
  "theme_color": "#1d4f3a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "files": [{ "name": "dateien", "accept": ["application/pdf", "image/*", ".pdf", ".jpg", ".jpeg", ".png", ".heic"] }]
    }
  },
  "shortcuts": [
    { "name": "Dokument ablegen", "url": "./#dokumente" },
    { "name": "Vorsorge", "url": "./#vorsorge" }
  ]
}
